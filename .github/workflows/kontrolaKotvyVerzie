name: Kontrola kotvy verzie

# Kotva v scripts/generate-version.mjs sa musí občas posunúť, inak build na
# Verceli spadne (plytký klon nedosiahne dosť ďaleko do histórie — pozri
# docs/verziovanie.md, "Kotva sa musí občas posunúť"). Tento krok zlyhá
# skôr, než sa to stane.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

jobs:
  kontrola:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      # fetch-depth: 0 – bez plnej histórie sa vzdialenosť kotvy od main
      # nedá overiť (presne ten stav, ktorý má tento krok odchytiť skôr).
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Vzdialenosť kotvy od main
        run: node scripts/check-version-anchor.mjs
