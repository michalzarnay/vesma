{
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/vesma/api/(.*)", "destination": "/api/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/vesma", "destination": "/vesma/index.html" },
    { "source": "/vesma/(.*)", "destination": "/vesma/index.html" }
  ],
  "redirects": [{ "source": "/", "destination": "/vesma/", "permanent": false }]
}
