{
  "name": "vesma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "version:generate": "node scripts/generate-version.mjs",
    "verzia": "git fetch origin main --quiet || true && node scripts/bump-version.mjs",
    "predev": "npm run version:generate",
    "dev": "vite",
    "prebuild": "npm run version:generate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "prepreview": "npm run version:generate",
    "preview": "vite preview",
    "pretest": "npm run version:generate",
    "test": "tsc -b && eslint . --max-warnings=0",
    "pretest:unit": "npm run version:generate",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "jspdf": "^4.1.0",
    "lucide-react": "^0.574.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
