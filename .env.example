# Konfigurácia VESMA mostu (Google Apps Script Web App), ktorý zapisuje
# podnety a nezodpovedané otázky chatbota do Google Sheetu.
#
# Skopíruj tento súbor ako .env a doplň skutočné hodnoty:
#   cp .env.example .env
#
# Rovnaké dve premenné musia byť nastavené aj vo Vercel projekte
# (Settings -> Environment Variables), inak /api/feedback vráti 503.
#
# .env je v .gitignore – NIKDY ho necommituj, obsahuje tajomstvo.

SHEET_WEBAPP_URL=
SHEET_WEBHOOK_SECRET=
